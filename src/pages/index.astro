---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="Welcome to myAlgs.">
	<main class="pb-32 mx-auto p-4 w-[800px] max-w-[calc(100%-2rem)] text-white text-[20px] leading-[1.6]">
		<h1 class="text-7xl font-bold leading-none text-center mb-4">Welcome to <span class="text-gradient">myAlgs</span></h1>
		<p class="instructions">
			This is the page where I compile and share all algorithms I use in speedcubing. This guide is oriented to learn the best algorithms the easiest way by learning them in an specific order, which I recommend. 
		</p>
		<ul role="list" class="link-card-grid">
			<Card
				href="/myAlgs/oll"
				title="OLL"
				body="Orientation of the last layer."
			/>
			<Card
				href="/myAlgs/pll"
				title="PLL"
				body="Permutation of the last layer."
			/>
			<Card
				href="/myAlgs/cll"
				title="CLL"
				body="Corners of the last layer (2x2) (Coming soon...)"
			/>
			<Card
				href="https://discordapp.com/users/osmofosis"
				title="Contact me on Discord!"
				body="I will answer any requests or suggestions."
			/>
		</ul>
	</main>
</Layout>

<style>
	.astro-a {
		position: absolute;
		top: -32px;
		left: 50%;
		transform: translatex(-50%);
		width: 220px;
		height: auto;
		z-index: -1;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
	.instructions code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.instructions strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
</style>
