---
import { Image } from 'astro:assets';

interface Props {
   imgSrc: string;
   imgDsc: string;
   alg: string;
   caseDsc: string;
}

const { imgSrc, imgDsc, alg, caseDsc } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/img/*/*.{jpeg,jpg,png,gif}')
if (!images[imgSrc]) throw new Error(`"${imgSrc}" does not exist in glob: "/src/img/*/*.{jpeg,jpg,png,gif}"`);
---
<div class="bg-white rounded-xl shadow-md border border-gray-200 p-4 flex flex-col items-center md:flex-row md:items-start gap-4 md:gap-6 mb-6">
  <div class="w-24 h-24 flex-shrink-0 flex items-center justify-center">
    <Image src={images[imgSrc]()} alt={imgDsc} class="object-contain w-full h-full rounded" />
  </div>
  <div class="flex-1 w-full">
    <h2 class="text-xl font-extrabold text-indigo-700 mb-1">{imgDsc}</h2>
    <h3 class="text-lg font-bold text-gray-800 mb-2">{alg}</h3>
    <p class="text-gray-600">{caseDsc}</p>
  </div>
</div>